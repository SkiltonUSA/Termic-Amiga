@NODE MAIN "Termic Amiga - User Guide"
@{b}Termic Amiga 0.1.0 Beta@{ub}
Native MUI development workspace for AmigaOS 3.2 / 68020+.

  @{"Getting started" LINK Start}       @{"Installation" LINK Install}
  @{"Projects and tasks" LINK Projects}    @{"Source editor" LINK Editor}
  @{"Build and run" LINK Build}         @{"AmigaDOS commands" LINK Shell}

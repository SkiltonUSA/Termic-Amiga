  @{"About / version" LINK About}       @{"Agent / API key" LINK Agent}
  @{"AmigaDOS" LINK Shell}              @{"Backups" LINK Storage}
  @{"Build command" LINK Build}         @{"Cancel / busy jobs" LINK Trouble}
  @{"Clipboard / IFF" LINK Sharing}      @{"Colours" LINK Editor}

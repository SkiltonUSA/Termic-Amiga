FailAt 10
Execute Termic:Setup
CD Termic:Source
; Crypto runs in AmiSSL. Keep the small transport unit at O0.
vc +aos68k -cpu=68020 -O0 -ITermic:SDK/AmiSSL/Developer/include -c tls.c -o tls.o
If WARN
  Quit 20
EndIf
vc +aos68k -cpu=68020 -O1 worker.c hardware.c relay.c profiles.c agent.c change_review.c files.c workspace.c http.c tls.o vendor/cJSON.c -o Termic:TermicAgent.new -lamiga -lmieee
If WARN
  Quit 20
EndIf
vc +aos68k -cpu=68020 -O1 -ITermic:SDK/MUI/Developer/C/Include -ITermic:SDK/MCC_TextEditor/Developer/C/include -ITermic:apps/process-monitor -DTERMIC_EMBEDDED gui.c Termic:apps/process-monitor/main.c diagnostics.c change_review.c taskflow.c prompts.c profiles.c vendor/cJSON.c files.c workspace.c syntax.c -o Termic:TermicNative.new -lamiga -lmieee
If WARN
  Quit 20
EndIf
vc +aos68k -cpu=68020 -O1 mcp.c profiles.c files.c workspace.c vendor/cJSON.c -o Termic:TermicMCP.new -lamiga -lmieee
If WARN
  Quit 20
EndIf
vc +aos68k -cpu=68020 -O1 check_deps.c -o Termic:TermicCheck -lamiga
If WARN
  Quit 20
EndIf
Protect Termic:TermicCheck +e
vc +aos68k -cpu=68020 -O1 storage.c files.c workspace.c -o Termic:TermicStorage.new -lamiga
If WARN
  Quit 20
EndIf
If EXISTS Termic:TermicStorage
  Delete Termic:TermicStorage
EndIf
Rename Termic:TermicStorage.new Termic:TermicStorage
Protect Termic:TermicStorage +e
If EXISTS Termic:TermicAgent
  Delete Termic:TermicAgent
EndIf
Rename Termic:TermicAgent.new Termic:TermicAgent
If EXISTS Termic:TermicNative
  Delete Termic:TermicNative
EndIf
Rename Termic:TermicNative.new Termic:TermicNative
Protect Termic:TermicAgent +e
Protect Termic:TermicNative +e
If EXISTS Termic:TermicMCP
  Delete Termic:TermicMCP
EndIf
Rename Termic:TermicMCP.new Termic:TermicMCP
Protect Termic:TermicMCP +e
vc +aos68k -cpu=68020 -O1 workbench.c -o Termic:TermicLauncher.new -lamiga
If WARN
  Quit 20
EndIf
If EXISTS "Termic:Termic Amiga"
  Delete "Termic:Termic Amiga"
EndIf
Rename Termic:TermicLauncher.new "Termic:Termic Amiga"
Protect "Termic:Termic Amiga" +e
If NOT EXISTS "Termic:Termic Amiga.info"
  "Termic:Termic Amiga" --make-icons
EndIf
Echo "Termic native applications and Workbench launcher built on this Amiga."
